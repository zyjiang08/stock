FROM python:3.12-slim@sha256:12316debbfb86890f6b2d825820612741ba527ad5a44e3902759141d572bfe8f AS dependencies
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt && useradd --uid 10001 --create-home web
FROM dependencies AS runtime
COPY --chown=10001:10001 src/backtester.py src/web_app.py ./src/
COPY --chown=10001:10001 data/demo_prices.csv ./data/
COPY --chown=10001:10001 web ./web/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "45", "--worker-tmp-dir", "/tmp", "--access-logfile", "-", "src.web_app:app"]
